# Copy to .env (or set real environment variables on your host)
PORT=8080
# Production persistence. Neon is primary when configured; SQLite remains the local fallback.
NEON_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require
# LiveKit Cloud or self-hosted server connection details. Keep the secret server-side only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
# Google Web OAuth credentials (never put these in the Android app).
# Use either GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET or a protected server-side JSON file.
GOOGLE_OAUTH_CLIENT_FILE=/secure/server/path/google-web-client.json
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Register this exact HTTPS URL in Google Cloud Console OAuth client settings.
GOOGLE_REDIRECT_URI=https://your-api.example.com/api/youtube/oauth/callback
GOOGLE_APP_REDIRECT_URI=uniquestream://youtube-connected
# Generate with: openssl rand -hex 32. Keep stable; changing it invalidates saved refresh tokens.
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
# Where the SQLite database file lives. Mount a volume here in Docker.
DB_PATH=./data/talk.db
# Max voice frame size accepted from a client (bytes)
MAX_VOICE_FRAME=1200
# Max members per room (hard cap, rooms can set lower)
MAX_ROOM_MEMBERS=12
